# Regenerable or externally hosted benchmark assets.
downloads/**
data/*.jsonl
data/*.json
data/*.txt

# Keep documentation/manifest files inside ignored data folders.
!downloads/README.md
!data/README.md
!data/reference_company100_qids.json

# `results/` is intentionally versionable for selected, curated evidence.

# Historical benchmark runs kept locally for investigation only.
.local-results/

# Private planning and collaboration notes; not part of the published project.
.local-notes/

# Local benchmark metadata; only the sanitized run-config.json is published.
*.config.json

.vscode/

# Scratch scripts for local fixes and research exploration.
scripts/

# Legacy website output locations; new builds use ignored build/site/.
docs/index.html
docs/assets/site.css
docs/assets/site.js
docs/data/tool-catalog.json
docs/data/example-trajectory.json
docs/.nojekyll
# Generated results presentation; benchmark archives remain in results/.
docs/results.html
docs/model-*.html
docs/run-*.html
docs/comparison*.html
docs/assets/comparison.js
docs/data/comparison/
docs/assets/results.css
docs/assets/results.js
docs/assets/results-ui.js
docs/data/results/
